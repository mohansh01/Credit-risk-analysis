# .env.example — Copy this to .env and fill in your values
# NEVER commit .env to git (add .env to .gitignore)

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# MLflow Tracking (optional)
# MLFLOW_TRACKING_URI=http://localhost:5000

# Model Paths (optional overrides)
# XGB_MODEL_PATH=models/artifacts/xgb_model.pkl
# LGBM_MODEL_PATH=models/artifacts/lgbm_model.pkl
