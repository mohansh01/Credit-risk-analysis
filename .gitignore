.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp

# Logs
*.log
logs/

# Reports (regenerated on run)
reports/*.html
reports/*.json

# Pytest cache
.pytest_cache/
